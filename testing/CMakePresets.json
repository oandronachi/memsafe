{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "_comment": "Convenience presets for IDE users. They mirror testing/infra_lanes.json. The generic build only understands INFRA_* knobs; the MEMSAFE_* values below are this code base's lane choices, not something the tool assumes.",
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "INFRA_STD": "20" }
    },
    { "name": "debug",      "inherits": "base", "displayName": "Debug (checks on)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "release",    "inherits": "base", "displayName": "Release (checks off)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "INFRA_DEFINES": "MEMSAFE_RELEASE_CHECKS=0" } },
    { "name": "asan-ubsan", "inherits": "base", "displayName": "ASan+UBSan (GNU/Clang)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "INFRA_SANITIZE": "address,undefined" } },
    { "name": "cxx17",      "inherits": "base", "displayName": "C++17 compatibility mode",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "INFRA_STD": "17", "INFRA_DEFINES": "MEMSAFE_CXX17_COMPAT=1" } },
    { "name": "tsan",       "inherits": "base", "displayName": "Optional TSan",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "INFRA_SANITIZE": "thread" } },
    { "name": "msan",       "inherits": "base", "displayName": "Optional MSan",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "INFRA_SANITIZE": "memory" } },
    { "name": "hwasan",     "inherits": "base", "displayName": "Optional HWASan",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "INFRA_SANITIZE": "hwaddress" } },
    { "name": "valgrind-cxx17", "inherits": "base", "displayName": "Optional Valgrind C++17",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "INFRA_STD": "17", "INFRA_DEFINES": "MEMSAFE_CXX17_COMPAT=1", "INFRA_TEST_LAUNCHER": "valgrind;--error-exitcode=125;--leak-check=full" } },
    { "name": "property",   "inherits": "base", "displayName": "Optional property tests",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "INFRA_DEFINES": "MEMSAFE_ENABLE_PROPERTY_TESTS=1", "INFRA_TEST_GLOBS": "tests/*.cpp;tests/property/*.cpp" } },
    { "name": "fuzz",       "inherits": "base", "displayName": "Optional fuzz tests",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "INFRA_DEFINES": "MEMSAFE_ENABLE_FUZZ_TESTS=1", "INFRA_TEST_GLOBS": "tests/*.cpp;tests/fuzz/*.cpp" } },
    { "name": "concurrency", "inherits": "base", "displayName": "Optional concurrency tests",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "INFRA_DEFINES": "MEMSAFE_ENABLE_CONCURRENCY_TESTS=1", "INFRA_TEST_GLOBS": "tests/*.cpp;tests/concurrency/*.cpp" } },
    { "name": "perf",       "inherits": "base", "displayName": "Optional performance tests",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "INFRA_DEFINES": "MEMSAFE_RELEASE_CHECKS=0;MEMSAFE_ENABLE_PERF_TESTS=1", "INFRA_TEST_GLOBS": "tests/*.cpp;tests/perf/*.cpp" } }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan-ubsan", "configurePreset": "asan-ubsan" },
    { "name": "cxx17", "configurePreset": "cxx17" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "msan", "configurePreset": "msan" },
    { "name": "hwasan", "configurePreset": "hwasan" },
    { "name": "valgrind-cxx17", "configurePreset": "valgrind-cxx17" },
    { "name": "property", "configurePreset": "property" },
    { "name": "fuzz", "configurePreset": "fuzz" },
    { "name": "concurrency", "configurePreset": "concurrency" },
    { "name": "perf", "configurePreset": "perf" }
  ],
  "testPresets": [
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "asan-ubsan", "configurePreset": "asan-ubsan", "output": { "outputOnFailure": true } },
    { "name": "cxx17", "configurePreset": "cxx17", "output": { "outputOnFailure": true } },
    { "name": "tsan", "configurePreset": "tsan", "output": { "outputOnFailure": true } },
    { "name": "msan", "configurePreset": "msan", "output": { "outputOnFailure": true } },
    { "name": "hwasan", "configurePreset": "hwasan", "output": { "outputOnFailure": true } },
    { "name": "valgrind-cxx17", "configurePreset": "valgrind-cxx17", "output": { "outputOnFailure": true } },
    { "name": "property", "configurePreset": "property", "output": { "outputOnFailure": true } },
    { "name": "fuzz", "configurePreset": "fuzz", "output": { "outputOnFailure": true } },
    { "name": "concurrency", "configurePreset": "concurrency", "output": { "outputOnFailure": true } },
    { "name": "perf", "configurePreset": "perf", "output": { "outputOnFailure": true } }
  ]
}
